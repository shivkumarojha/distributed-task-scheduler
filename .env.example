# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value below is OPTIONAL — the app ships with
# sane defaults (see src/config/env.ts). Anything you omit falls back to default.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# ---- Redis connection ------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave both blank for a password-less local Redis. Set for Upstash / cloud.
REDIS_PASSWORD=
REDIS_USERNAME=
# Logical database index (0-15 by default).
REDIS_DB=0
# All keys created by this app are namespaced with this prefix.
REDIS_KEY_PREFIX=dts

# ---- Redis timeouts / retry ------------------------------------------------
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_MAX_RETRY_DELAY_MS=2000
